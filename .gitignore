# PDF fuente (pesados, no versionar)
source_pdfs/
*.pdf

# Imágenes de cartas renderizadas (regenerables), salvo las de SCEL que
# usa el prototipo como demo autocontenida.
data/charts/*
!data/charts/SCEL
data/charts/SCEL/*
!data/charts/SCEL/*.jpg
!data/charts/SCEL/*.json
*.jpg
*.png
# ...pero sí versionamos los mockups de diseño y las cartas de SCEL
!design/**/*.png
!data/charts/SCEL/*.jpg

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Expo / Vite (app PWA)
node_modules/
.expo/
dist/
.vite/
dev-dist/

# PWA app: datos sincronizados desde /data (regenerables con npm run sync-data)
app/public/data/
app/public/charts/
# ...pero sí versionamos los iconos de la PWA (los ignora *.png de arriba)
!app/public/icons/*.png

# TypeScript incremental
*.tsbuildinfo
